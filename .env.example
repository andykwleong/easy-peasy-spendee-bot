# Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs.
ME_TELEGRAM_IDS=
WIFE_TELEGRAM_IDS=

# Optional display labels written into Google Sheets.
ME_LABEL=Me
WIFE_LABEL=My wife

# Optional labels for the buttons that open the other person's credit cards.
ME_CARD_BUTTON_LABEL=Partner's Cards
WIFE_CARD_BUTTON_LABEL=Partner's Cards

# Required only for scheduled Railway reminders and final summaries.
# Send /whoami in the group chat to see the Telegram chat ID.
TELEGRAM_CHAT_ID=

# Google Sheets
GOOGLE_SHEET_ID=

# Local Mac setup: use the path to your downloaded service account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Railway setup: paste the full service account JSON as one secret variable instead of using a local file path.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional sheet tab names.
RAW_EXPENSES_SHEET=Raw Expenses
FIXED_EXPENSES_SHEET=Fixed Expenses
MONTHLY_SUMMARY_SHEET=Monthly Summary
BOT_STATE_SHEET=Bot State

# Categories and payment setup
# Production setup: keep categories and payment setup in your Google Sheet tabs.
CATEGORIES_SHEET=Categories
CATEGORY_KEYWORDS_SHEET=Category Keywords
PAYMENT_METHODS_SHEET=Payment Methods
CARD_LIMITS_SHEET=Card Limits
CARD_USAGE_SHEET=Card Usage

# Optional. Enables screenshot, voice-note, natural-language delete/edit/question handling, and richer extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional. One shop-name search when an emailed shop is not already a category keyword.
# Put the real key only in Railway or your local .env. This placeholder is fake.
EXA_API_KEY=your-exa-api-key

# Private dashboard.
# The public https address of this same app, after Railway gives you one.
# Example shape only: https://your-app.example.com
# Leave this blank until you have that address.
# Until it is set, the Dashboard button in Telegram does nothing useful.
# This is a web address, not a password. Do not put a token or card number here.
DASHBOARD_PUBLIC_URL=

# Email logging stays off until this is true, yes, 1, or on, and the Gmail values below are set.
# Missing values must not stop the Telegram bot.
EMAIL_LOGGING_ENABLED=false

# Gmail read permission. This is separate from the Google Sheets service account.
# Use fake placeholders here. Put the real values only in Railway or your local .env.
GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=your-refresh-token

# Pub/Sub topic that taps the bot when new mail arrives.
# Shape only: projects/your-project-id/topics/your-topic-name
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/your-topic-name

# Optional. The address Google uses when it taps this app.
# If blank, the bot uses DASHBOARD_PUBLIC_URL with /gmail/push on the end.
# Example shape only: https://your-app.example.com/gmail/push
GMAIL_PUBSUB_AUDIENCE=

# Optional. If set, only this Google service account may send the tap.
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# The personal addresses that forward bank mail. Not the mailbox itself.
# Placeholders only. Do not put a real address in the repo.
ME_FORWARDER_EMAIL=person-a@example.com
WIFE_FORWARDER_EMAIL=person-b@example.com
